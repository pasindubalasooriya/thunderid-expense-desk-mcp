# --- MCP server ---
MCP_HOST=127.0.0.1
MCP_PORT=8000

# The resource identifier registered in ThunderID. Tokens must carry this as `aud`.
MCP_RESOURCE_ID=http://localhost:8000/mcp

# --- ThunderID ---
# Base URL of your local ThunderID. The bundled Windows dist binds 8095.
THUNDERID_ISSUER=https://localhost:8095
THUNDERID_JWKS_URI=https://localhost:8095/oauth2/jwks

# scopes  = layer 1 only (token scopes decide)
# authzen = layer 1 + a runtime PDP call before each protected tool
AUTHORIZATION_MODE=scopes

# Gate for ThunderID's Direct APIs, sent as the Direct-Auth-Secret header on
# AuthZEN calls. ThunderID generates this during setup; read it from
# <thunderid>/config/secrets/direct_auth_secret and paste the value here.
THUNDERID_DIRECT_AUTH_SECRET=

# Local ThunderID uses a self-signed certificate. Local dev only.
THUNDERID_VERIFY_TLS=false

# Set to false to run the server with no authorization at all (the S01 demo).
AUTH_ENABLED=true

# Maps ThunderID subjects (the token's `sub`) to this application's usernames.
# Your app keeps its own user table; this stands in for it. Join on `sub` --
# never on email or username, which change.
PRINCIPAL_MAP={"<andrea-subject-uuid>":"andrea","<mike-subject-uuid>":"mike"}

# The triage agent's own credentials (client_credentials grant).
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=

# Where state and the audit trail live.
STORE_PATH=expenses.json
AUDIT_PATH=audit.jsonl
# Set true to reseed the store on next start.
RESET_STORE=false
